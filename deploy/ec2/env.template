# Copy to repo root as `.env` and fill in secrets. Paths below are relative to the
# `market_analysis/` repo root (parent of `telegram_agent/`).

OPENROUTER_API_KEY=

# Optional: default DB location is telegram_agent/data/agent.sqlite
# AGENT_DB_PATH=telegram_agent/data/agent.sqlite

SYMBOL_UNIVERSE_PATH=telegram_agent/top1000_investments.json

# Orchestrator append log (relative to repo root)
ORCHESTRATOR_LOG_PATH=telegram_agent/data/orchestrator.log

# Headless server: research/memory posts to TARGET_CHANNEL after each research run
AGENT_RESEARCH_PUBLISH=true
AGENT_RESEARCH_BACKFILL_PUBLISH=false

# Add your other keys (TELEGRAM_*, FINNHUB_*, etc.) from your laptop `.env`.

# --- Regression walk-forward (daily after orchestrator, ~22:30 UTC) ---
# REGRESSION_WF_DAILY=1
# REGRESSION_WF_YEARS=2.0
# REGRESSION_WF_MODE=auto
# REGRESSION_WF_MAX_FOLDS=8
# REGRESSION_WF_MIN_TRAIN_ROWS=80
# REGRESSION_WF_SKIP_TECHNICALS=0

# --- Interactive Brokers paper trading (regression on technicals) ---
# Requires TWS or IB Gateway logged into a PAPER account with API enabled.
# IB_HOST=127.0.0.1
# IB_PORT=7497
# IB_CLIENT_ID=61
# IB_ACCOUNT=
# IB_PAPER_REGRESSION=1
# IB_PAPER_EXECUTE=0
# IB_PAPER_DEPLOY_FRACTION=0.95
# ML_PAPER_BACKEND_DIR=backend
