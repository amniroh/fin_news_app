# Copy to `.env` in this directory and fill in. NEVER commit the filled file.
#   cp .env.example .env
#   nano .env

# Interactive Brokers login (same username can access paper + live;
# TRADING_MODE=paper in docker-compose.yml selects the paper session).
TWS_USERID=
TWS_PASSWORD=

# Optional: VNC password to view Gateway UI (SSH tunnel to localhost:5900).
# Leave empty to disable remote desktop.
VNC_SERVER_PASSWORD=

TIME_ZONE=America/New_York
