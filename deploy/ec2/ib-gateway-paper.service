[Unit]
Description=Interactive Brokers Gateway (PAPER only) via Docker Compose
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ec2-user
WorkingDirectory=/home/ec2-user/market_analysis/deploy/ec2/ib-gateway
Environment=HOME=/home/ec2-user
# Fail fast if credentials were never filled in.
ExecStartPre=/usr/bin/bash -c 'test -f .env && grep -q "^TWS_USERID=.\+" .env && grep -q "^TWS_PASSWORD=.\+" .env'
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
